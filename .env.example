NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Ignora as regras de linha do banco. Só três lugares usam: criar login,
# o callback do Mercado Livre e a sincronização. Nunca com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de 32 bytes em base64 para cifrar as senhas dos acessos e os tokens
# do Mercado Livre.
# Gere com: openssl rand -base64 32
# Precisa ser a MESMA no .env.local e na Vercel, ou as senhas já salvas não abrem
# e todos os clientes precisam reconectar o Mercado Livre.
CREDENTIALS_KEY=

# ---- Mercado Livre ----
# Do aplicativo criado em developers.mercadolivre.com.br com a conta da TAKT.
# No aplicativo: PKCE ativo, escopos de Leitura e offline_access (sem o
# offline_access o ML não devolve refresh token e a conexão cai em 6 horas),
# e URI de redirect IGUAL a https://taktgestao.vercel.app/api/meli/callback
# — com https e sem barra no final.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Só para desenvolvimento, quando a URI registrada não é a de produção.
# ML_REDIRECT_URI=

# Autentica a sincronização automática. Gere com: openssl rand -base64 32
CRON_SECRET=

# ---- E-mail (link de acesso do cliente) ----
# Sem estes, o app devolve o link para copiar em vez de enviar.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=
